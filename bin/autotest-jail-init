#!/usr/bin/perl -w
# Copyright SUSE LLC
# SPDX-License-Identifier: GPL-2.0-or-later
use strict;
use warnings;
use IO::Socket;

# This script runs inside the MicroVM jail for autotest confinement.
# It connects to the host via vsock and runs the autotest logic.

# 1. Mount the data disk (Squashfs)
# We assume it is attached as /dev/vdb
system("mkdir -p /mnt/os-autoinst");
system("mount -o ro -t squashfs /dev/vdb /mnt/os-autoinst");

chdir("/mnt/os-autoinst");

# 2. Setup @INC and environment
unshift @INC, '/mnt/os-autoinst/lib';
unshift @INC, '/mnt/os-autoinst';

# Update CASEDIR and PRODUCTDIR if they are set
if ($ENV{CASEDIR} && $ENV{CASEDIR} !~ /^\//) {
    $ENV{CASEDIR} = "/mnt/os-autoinst/" . $ENV{CASEDIR};
}
if ($ENV{PRODUCTDIR} && $ENV{PRODUCTDIR} !~ /^\//) {
    $ENV{PRODUCTDIR} = "/mnt/os-autoinst/" . $ENV{PRODUCTDIR};
}

# 3. Load autotest and other required modules
require bmwqemu;
require myjsonrpc;
require autotest;

# 4. Connect to host via vsock
# Firecracker vsock uses AF_VSOCK (40 on Linux)
# We need a socket handle that autotest can use.
my $vsock_port = $ENV{AUTOTEST_VSOCK_PORT} || 1234;

# Since standard Perl Socket might not have AF_VSOCK, we use a raw socket
# or just assume we have it if we use a modern Perl.
# AF_VSOCK is 40.
# struct sockaddr_vm {
#    unsigned short svm_family;
#    unsigned short svm_reserved1;
#    unsigned int svm_port;
#    unsigned int svm_cid;
# };
my $AF_VSOCK = 40;
my $VMADDR_CID_HOST = 2;
my $sockaddr_vm = pack("SSII", $AF_VSOCK, 0, $vsock_port, $VMADDR_CID_HOST);

socket(my $sk, $AF_VSOCK, SOCK_STREAM, 0) or die "socket AF_VSOCK failed: $!";
connect($sk, $sockaddr_vm) or die "connect AF_VSOCK failed: $!";
$sk->autoflush(1);

# 5. Tell autotest to use this socket to talk to isotovideo
$autotest::isotovideo = $sk;

# 6. Signal we are ready
# The host waits for GO\n, but the guest needs to receive GO\n first?
# Actually, isotovideo (host) sends GO\n to the autotest process.
# So we wait for it.
print "autotest-jail-init: Waiting for GO from host...\n";
my $line = <$sk>;
die "autotest-jail-init: Unexpected GO line: $line" unless $line && $line =~ /^GO/;
print "autotest-jail-init: GOT GO, starting tests.\n";

# 7. Start the tests
autotest::run_all();
